# 의존성
node_modules/

# 런타임 데이터 (DB에 비밀번호 해시, JWT 시크릿, 업로드 파일 포함 — 절대 커밋 금지)
data/

# 로컬 백업 (OneDrive가 없는 PC에서 scripts/backup.js 기본 대상)
backups/

# 빌드 산출물 (npm install 후 postinstall이 자동 복사)
public/lib/phaser.min.js

# 설비 스프라이트 중간 렌더 (assets/blender/render.cmd 가 만듦 — 최종 PNG는 public/assets/equipment/ 에 커밋)
assets/blender/out/

# 로그/임시
*.log

# 파이썬 캐시 (assets/blender·scripts/bldc 스크립트 검사·실행 시 생김)
__pycache__/

# 부하 테스트 전용 데이터 폴더 (docs/운영전환-가이드.md §4 — FW_DATA_DIR=data-loadtest)
data-loadtest/
